<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 로그인과 결제는 시스템 브라우저에서 처리한다. 구글이 임베디드 WebView
                 안의 OAuth 를 막기 때문이다. 끝나고 umsh.kr 로 돌아오는 주소를 이
                 필터가 받아 앱으로 다시 들여보낸다. autoVerify 가 동작하려면
                 https://umsh.kr/.well-known/assetlinks.json 이 서명 인증서
                 지문과 함께 올라가 있어야 한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="umsh.kr" />
                <data android:scheme="https" android:host="www.umsh.kr" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 푸시 알림(FCM). 앱이 백그라운드·종료 상태면 FCM SDK 가 직접 알림을 그리므로
             아이콘·색·채널을 여기서 정해 둔다. 작은 아이콘은 흰색 실루엣이어야 하며,
             앱 아이콘을 그대로 쓰면 상태 표시줄에 흰 네모로 보인다. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_umsh" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/umsh_notification_accent" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="@string/default_notification_channel_id" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 구글플레이 인앱 결제. billing 라이브러리도 같은 권한을 선언하므로 병합되지만,
         이 앱이 결제를 쓴다는 사실을 매니페스트에 남겨 둔다. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- 천명상담 음성 상담(Gemini Live)이 getUserMedia 로 마이크를 연다. Capacitor 의
         BridgeWebChromeClient.onPermissionRequest 가 이 두 권한을 런타임에 요청한 뒤
         WebView 에 승인을 넘긴다. 선언이 없으면 권한 창 없이 바로 거부된다.
         거부해도 웹이 텍스트 상담으로 안내하므로 앱은 계속 쓸 수 있다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 마이크 없는 기기도 설치는 되게 한다. 음성 상담만 쓰지 못한다. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 13+ 알림 권한. firebase-messaging 도 선언하지만 앱이 푸시를 쓴다는 사실을
         남겨 둔다. 런타임 요청은 웹(umsh-push.js)이 로그인 직후 안내 시트를 보여 준 뒤 한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
