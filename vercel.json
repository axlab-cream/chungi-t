{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{admin-ui,data,prompts,사주}/**"
    }
  },
  "crons": [
    { "path": "/api/cron/ops", "schedule": "* * * * *" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index?__umsh_path=$1"
    }
  ]
}
