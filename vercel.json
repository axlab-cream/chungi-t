{
  "version": 2,
  "regions": ["icn1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{admin-ui/**,data/**,prompts/**,.vercel-runtime/**,tone-v2/generated/**,tone-v2/source/규격/**,tone-v2/{PRD.md,PLAN.md,HANDOFF-PROMPT-20260912.md,report-budget.json}}"
    }
  },
  "crons": [
    { "path": "/api/cron/ops", "schedule": "* * * * *" }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index?__umsh_path=$1"
    }
  ]
}
