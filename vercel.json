{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/consultation-voice.py": {
      "maxDuration": 60,
      "includeFiles": "integrations/aitalk/**",
      "excludeFiles": "{node_modules,public,사주,assets,data,tone-v2,docs,tests,CreamAI,design-*,admin-*,android,backlog,evals,mcp,ops,prompts,scripts,src,supabase,wiki,.github,.claude,.vercel-runtime,운명상회*}/**"
    },
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{admin-ui/**,data/**,prompts/**,.vercel-runtime/**,tone-v2/generated/**,tone-v2/source/규격/**,tone-v2/{PRD.md,PLAN.md,HANDOFF-PROMPT-20260912.md,report-budget.json}}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ops",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index?__umsh_path=$1"
    }
  ],
  "git": {
    "deploymentEnabled": true
  }
}
