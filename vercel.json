{
  "version": 2,
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/consultation-voice.py": {
      "maxDuration": 60,
      "includeFiles": "integrations/aitalk/**",
      "excludeFiles": "{node_modules/**,public/**,사주/**,assets/**,data/**,tone-v2/**,docs/**,tests/**,CreamAI/**,design-system/**,design-workspace/**,admin-ui/**,admin-ops-execution-pack/**,android/**,backlog/**,evals/**,mcp/**,ops/**,prompts/**,scripts/**,src/**,supabase/**,wiki/**,.github/**,.claude/**,.vercel-runtime/**,운명상회 서비스 프롬프트 규칙/**}"
    },
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{admin-ui/**,data/**,prompts/**,사주/**,tone-v2/generated/**,tone-v2/source/규격/**,tone-v2/PRD.md,tone-v2/PLAN.md,tone-v2/HANDOFF-PROMPT-20260912.md,tone-v2/report-budget.json}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ops",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index?__umsh_path=$1"
    }
  ]
}
