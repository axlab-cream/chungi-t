{
  "name": "chungi_t",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "천명사주 개인 사주 기반 LLM 대화 엔진",
  "scripts": {
    "dev": "tsx src/cli/demo.ts",
    "start": "tsx src/server/app.ts",
    "test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/prepare-vercel-public.mjs && npm run typecheck",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:pass-angle": "node scripts/check-pass-angle.mjs",
    "check:marry": "node scripts/check-marry.mjs",
    "check:save": "node scripts/check-save.mjs",
    "check:quit": "node scripts/check-quit.mjs",
    "check:couple": "node scripts/check-couple.mjs",
    "check:signal": "node scripts/check-signal.mjs",
    "check:thisyear": "node scripts/check-thisyear.mjs",
    "check:jobchoice": "node scripts/check-jobchoice.mjs",
    "check:cat": "node scripts/check-cat.mjs",
    "check:polish": "node scripts/check-flow-polish.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "korean-lunar-calendar": "^0.4.0",
    "lunar-typescript": "^1.8.6",
    "openai": "^4.77.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
