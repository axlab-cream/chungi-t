# Copy to .env and fill in real values. src/env/load.ts loads .env first, then
# .env.local with override:true.
#
# WARNING - do not create .env.local with `vercel env pull`. Every secret in this
# project is marked Sensitive in Vercel, so a pull writes them back as empty
# strings, and .env.local wins the override. That silently blanks a working
# OPENAI_API_KEY. Pull to a file outside the repo, compare, then copy by hand.
#
# configuredEnv() in src/env/load.ts rejects any value starting with `your-`, so
# the placeholders below stay "not configured" until you replace them.

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
PORT=8790

# Server-only 풍수아씨 terrain/RAG API integration for the home-fit report.
# PUNGSU_DATASET_API_KEY is accepted as a fallback alias for PUNGSU_API_KEY
# (src/pungsu/dataset-client.ts). Prefer PUNGSU_API_KEY.
PUNGSU_DATASET_API_BASE=https://pungsu.ai.kr/api/v1
PUNGSU_API_KEY=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-legacy-anon-key
SUPABASE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SUPABASE_GOOGLE_PROVIDER=google
SUPABASE_KAKAO_PROVIDER=kakao
SUPABASE_NAVER_PROVIDER=custom:naver

# Server-side key that bypasses RLS. Required for payment order storage, because the
# PG return callback is a server-to-server POST with no end-user session to authorize it.
# Without this (or DATABASE_URL) payment orders fall back to memory and checkout stays disabled.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated emails that unlock paid reports without checkout.
UMSH_ADMIN_EMAILS=admin@example.com

# Optional: overrides OPENAI_MODEL for paid report generation only.
REPORT_OPENAI_MODEL=gpt-4o

# Optional: enables direct Postgres storage instead of Supabase REST/RLS storage.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# KG Inicis Standard Pay. Keep the SignKey server-side and configure the same MID in the PG console.
PUBLIC_BASE_URL=https://umsh.kr
INICIS_MID=your-inicis-mid
INICIS_SIGNKEY=your-inicis-signkey

# Local-only checkout simulation. Ignored when NODE_ENV=production.
# Set to 1 locally to reach the paid-report flow without real Inicis credentials
# (src/payment/test-mode.ts, src/server/app.ts checkoutEnabled).
PAYMENT_TEST_MODE=false

# Optional: directory for local report snapshots. Used only when neither
# DATABASE_URL nor SUPABASE_SERVICE_ROLE_KEY is set (src/report/report-store.ts).
REPORT_STORAGE_DIR=.cache/report-snapshots

# 구글플레이 인앱 결제 영수증 검증. 앱에서 결제한 건을 서버가 구글에 직접 물어본다.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON 은 Play Console 에서 내려받은 서비스 계정 JSON 키를
# 그대로 넣거나 base64 로 인코딩해 넣는다. 둘 다 받는다.
# 이 두 값이 없으면 /api/payment/google/verify 는 503 을 돌려주고 앱 결제는 열리지 않는다.
GOOGLE_PLAY_PACKAGE_NAME=kr.umsh.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
